¢††††††††††††††††¢††††††¢†††††††††¢††††††¢††††††¢††¢††††††¢††††††¢†††††††††¢††††††¢†††††††††¢††††††¢††††††¢†††††††††¢††††¢†¢††¢¢††††¢¢†¢††¢†¢¢†¢¢†¢¢†¢¢†¢††¢†¢¢†¢¢†¢¢†¢††¢††¢†¢¢†¢¢†¢¢†¢††¢††¢†¢¢†¢¢†¢¢†¢††¢†¢¢†¢¢†¢¢†¢¢†¢††¢†¢¢†¢¢†¢¢†¢¢†¢††¢†¢¢†¢¢†¢¢†¢††¢††¢†¢¢†¢¢¢¢¢†¢¢¢¢††¢¢¢¢†¢¢¢¢¢†¢¢¢¢††¢¢¢¢†¢¢¢¢¢†¢¢¢¢†¢¢¢¢¢†¢¢¢¢¢¢¢¢¢¢¢¢¢¢¢¢¢¢¢¢¢¢¢¢¢¢¢¢¢¢¢¢¢¢¢¢¢¢¢¢¢¢¢¢¢¢¢¢¢¢¢¢¢¢¢¢¢¢¢¢¢¢¢¢¢¢¢¢¢¢¢¢¢¢¢¢¢¢¢¢¢¢¢¢¢¢¢¢¢¢¢¢¢¢¢¢¢¢¢¢¢¢¢¢¢¢¢¢¢¢¢¢¢¢¢¢¢¢¢¢¢¢¢¢¢¢¢¢¢¢¢¢¢¢¢¢¢¢¢¢¢¢¢¢¢¢¢¢¢¢¢¢¢¢¢¢¢¢¢¢¢¢¢¢¢¢¢¢¢¢¢¢¢¢¢¢¢¢¢¢†¢¢¢¢¢†¢††¢†¢¢¢¢††¢†¢¢¢†¢¢†¢¢†¢¢¢†¢¢†¢¢¢†¢¢†¢¢†¢¢¢†¢¢†¢¢¢†¢¢¢¢¢¢¢¢¢†¢¢†¢¢¢†¢¢¢¢¢¢†¢¢†¢¢†¢¢¢†¢¢¢¢¢¢†¢¢†¢¢†¢¢¢†¢¢¢¢¢¢†¢¢†¢¢¢¢¢¢†¢¢¢¢¢¢†¢¢†¢¢¢¢¢¢¢¢¢¢¢¢¢†¢¢†¢¢¢¢¢¢¢¢¢¢¢¢¢†¢¢†¢¢¢¢¢¢¢¢¢¢†¢¢¢¢¢†¢¢¢¢¢¢¢¢¢¢†¢¢¢¢¢†¢¢¢¢¢¢¢¢¢¢¢¢¢¢¢¢¢¢¢¢¢¢¢¢¢¢¢†¢¢¢¢¢¢¢¢¢¢¢¢¢¢¢¢†¢¢¢¢¢¢¢¢¢¢¢¢¢¢¢¢†¢¢¢¢¢¢¢¢¢¢¢¢¢¢¢¢¢¢¢¢¢¢¢¢¢¢¢¢¢¢¢¢¢¢¢¢¢¢¢¢¢¢¢¢¢¢¢¢¢¢¢¢¢¢¢¢¢¢¢¢¢¢¢¢¢¢¢¢¢¢¢¢¢¢¢¢¢¢¢¢¢¢¢¢¢¢¢¢¢¢¢¢¢¢¢¢¢¢¢¢¢¢¢¢¢¢¢¢¢¢¢¢¢¢¢¢¢¢¢¢¢¢¢¢¢¢¢¢¢¢¢¢¢¢¢¢¢¢¢¢¢¢¢¢¢¢¢¢¢¢¢¢¢¢¢¢¢¢¢¢¢¢¢¢¢¢¢¢¢¢¢¢¢¢¢¢¢¢¢¢¢¢¢¢¢¢¢¢¢¢¢¢¢¢¢¢¢¢¢¢¢¢¢¢¢¢¢¢¢¢¢¢¢¢¢¢¢¢¢¢¢¢¢¢¢¢¢¢¢¢¢¢¢¢¢¢¢¢¢¢¢¢¢¢¢¢¢¢†¢¢¢¢††¢††¢†¢††¢††¢††¢††¢††¢†¢†¢¢††¢†¢¢††¢¢†¢¢¢†¢¢†¢¢††¢¢†¢¢†¢¢¢†¢¢¢¢¢¢†¢¢†¢¢†¢¢¢†¢¢¢¢¢¢†¢¢†¢¢†¢¢¢†¢¢¢¢¢¢†¢¢†¢¢¢¢¢¢†¢¢¢¢¢¢†¢¢†¢¢¢¢¢¢¢¢¢¢¢¢¢†¢¢†¢¢¢¢¢¢¢¢¢¢†¢¢†¢¢†¢¢¢¢¢¢¢¢¢¢†¢¢¢¢¢†¢¢¢¢¢¢¢¢¢¢†¢¢¢¢¢†¢¢¢¢¢¢¢¢¢¢¢¢¢¢¢¢¢¢¢¢¢¢¢¢¢¢¢†¢¢¢¢¢¢¢¢¢¢¢¢¢¢¢¢†¢¢¢¢¢¢¢¢¢¢¢¢¢¢¢¢†¢¢¢¢¢¢¢¢¢¢¢¢¢¢¢¢¢¢¢¢¢¢¢¢¢¢¢¢¢¢¢¢¢†¢¢¢¢¢¢¢¢¢¢¢¢¢¢¢¢¢¢¢¢¢¢¢¢¢¢¢¢¢¢¢¢¢¢¢¢¢¢¢¢¢¢¢¢¢¢¢¢¢¢¢¢¢¢¢¢¢¢¢¢¢¢¢¢¢¢¢¢¢¢¢¢¢¢¢¢¢¢¢¢¢¢¢¢¢¢¢¢¢¢¢¢¢¢¢¢¢¢¢¢¢¢¢¢¢¢¢¢¢¢¢¢¢¢¢¢¢¢¢¢¢¢¢¢¢¢¢¢¢¢¢¢¢¢¢¢¢¢¢¢¢¢¢¢¢¢¢¢¢¢¢¢¢¢¢¢¢¢¢¢¢¢¢¢¢¢¢¢¢¢¢¢¢¢¢¢¢¢¢¢¢¢¢¢¢¢¢¢¢¢¢¢¢¢¢¢¢¢¢¢¢¢¢¢¢¢¢¢¢¢¢¢¢¢†¢¢¢†††††††¢†††††††††¢††††††¢†††††††††¢††††††¢††††††††††††††††¢††††††¢†††††††††¢††††††¢†††††††††¢††††††¢††††††¢†††††††††¢††††††¢†††††††††¢†¢††††¢¢††††¢¢††††¢††¢†¢¢†¢¢†¢¢†¢††¢††¢†¢¢†¢¢†¢¢†¢††¢††¢†¢¢†¢¢†¢¢†¢††¢†¢¢†¢¢†¢¢†¢¢†¢††¢†¢¢†¢¢†¢¢†¢¢†¢††¢†¢¢†¢¢†¢¢†¢††¢††¢†¢¢†¢¢†¢¢†¢††¢††¢†¢¢†¢¢†¢¢†¢††¢††¢†¢¢†¢¢†¢¢†¢††¢††¢†¢¢†¢¢†¢¢†¢††¢†¢¢†¢¢†¢¢†¢¢†¢††¢¢¢¢†¢¢¢¢¢†¢¢¢¢††¢¢¢¢¢¢¢¢¢¢¢¢¢¢¢¢¢¢¢¢¢¢¢¢¢¢¢¢¢¢¢¢¢¢¢¢¢¢¢¢¢¢¢¢¢¢¢¢¢¢¢¢¢¢¢¢¢¢¢¢¢¢¢¢¢¢¢¢¢¢¢¢¢¢¢¢¢¢¢¢¢¢¢¢¢¢¢¢¢¢¢¢¢¢¢¢¢¢¢¢¢¢¢¢¢¢¢¢¢¢¢¢¢¢¢¢¢¢¢¢¢¢¢†¢¢¢¢††¢††¢†¢¢†¢¢†¢¢†¢††¢†¢¢††††¢††¢††¢¢†¢¢††¢††¢¢††¢††¢¢†¢¢††¢††¢¢††¢††¢¢†¢¢††¢¢†¢¢††¢††¢¢††¢††¢¢†¢¢††¢††¢¢††¢††¢¢†¢¢††¢††¢¢††¢¢†¢¢††¢†¢¢¢¢¢¢††¢¢†¢¢†¢¢†¢¢¢¢¢¢¢†¢¢†¢¢†¢¢†¢¢¢¢¢¢¢†¢¢†¢¢†¢¢†¢¢¢¢†¢¢†¢¢†¢¢†¢¢†¢¢¢¢†¢¢¢¢¢¢¢¢¢¢¢¢¢¢¢¢¢¢¢¢¢¢¢¢¢¢¢¢¢¢¢¢¢¢¢¢¢¢¢¢¢¢¢¢¢¢¢¢¢¢¢¢¢¢¢¢¢¢¢¢¢¢¢¢¢¢¢¢¢¢¢¢¢¢¢¢¢¢¢¢¢¢¢¢¢¢¢¢¢¢¢¢¢¢¢¢¢¢¢¢¢¢¢¢¢¢¢†¢¢¢¢¢¢¢¢¢¢¢¢¢¢¢¢¢¢¢¢¢¢¢¢¢¢¢†¢¢¢¢¢†¢¢¢¢¢¢¢¢¢¢¢¢¢¢¢¢¢¢¢¢¢¢¢¢¢¢¢¢¢¢¢¢¢¢¢¢¢¢¢¢¢¢¢¢¢¢¢¢¢¢¢¢¢¢¢¢¢¢¢¢¢¢¢¢¢¢¢¢¢¢¢¢¢¢¢¢¢¢¢¢¢¢¢¢¢¢¢¢¢¢¢¢¢¢¢¢¢¢¢¢¢¢¢¢¢¢¢¢¢¢¢¢¢¢¢¢¢¢¢¢¢¢¢¢¢¢¢¢¢¢¢¢¢¢¢¢¢¢¢¢¢¢¢¢¢¢¢¢¢¢¢¢¢¢¢¢¢¢¢¢¢¢¢¢¢¢¢¢¢¢¢¢¢¢†¢¢†¢¢†¢††¢†¢¢†¢¢†¢††¢††¢††¢†¢¢¢¢¢¢¢†¢¢¢¢¢¢¢¢¢¢¢¢¢¢¢¢†¢¢¢¢¢¢†¢¢¢¢¢¢¢¢¢¢¢¢¢¢¢¢†¢¢¢¢¢¢¢¢¢¢¢¢¢¢¢¢†¢¢¢¢¢¢¢¢¢¢¢¢¢¢¢¢¢¢¢¢¢¢¢¢¢¢¢¢¢¢¢¢¢¢¢¢¢¢¢¢¢¢¢¢¢¢¢¢¢¢¢¢¢¢¢¢¢¢¢¢¢¢¢¢†¢¢¢¢¢¢¢¢¢¢¢¢¢¢¢¢†¢¢¢¢¢¢¢¢¢¢¢¢¢¢¢¢¢¢¢¢¢¢¢¢¢¢¢¢¢¢¢¢¢¢¢¢¢¢¢¢¢¢¢¢¢¢¢¢¢¢¢¢¢¢¢¢¢¢¢¢¢¢¢¢¢¢¢¢¢¢¢¢¢¢¢¢¢¢¢¢¢¢¢¢¢¢¢¢¢¢¢¢¢¢¢¢¢¢¢¢¢¢¢¢¢¢¢¢¢¢¢¢¢¢¢¢¢¢¢¢¢¢¢¢¢¢¢¢¢¢¢¢¢¢¢¢¢¢¢¢¢¢¢¢¢¢¢¢¢¢¢¢¢¢¢¢¢¢¢¢¢¢¢¢¢¢¢¢¢¢¢¢¢¢¢¢¢¢¢¢¢¢¢¢¢¢¢¢¢¢¢¢¢¢¢¢¢¢¢¢¢¢¢¢¢¢¢¢¢¢¢¢¢¢¢¢¢¢¢¢¢¢¢¢¢¢¢¢¢¢¢¢¢¢¢¢¢¢¢¢¢¢¢¢¢¢¢¢¢¢¢¢¢¢¢¢¢¢¢¢¢¢¢¢¢¢¢¢¢¢¢¢¢¢¢¢¢¢¢¢¢¢¢¢¢¢¢¢¢¢¢¢¢¢¢¢¢¢¢¢¢¢¢¢¢¢¢¢¢¢¢¢¢¢¢¢¢¢¢¢¢¢¢¢¢¢¢¢¢¢¢¢¢¢††††¢††¢††¢†††¢††¢††¢¢††¢††¢†††¢††¢††¢¢††¢††¢†††¢††¢†††¢††¢††¢¢††¢††¢†††¢††¢††¢¢††¢††¢†††¢††¢††¢¢††¢††¢¢††¢††¢†††¢††¢††¢¢††¢††¢†††¢††¢††¢¢††¢††¢¢††¢†¢¢†††¢¢†¢¢†¢¢†¢¢†¢¢†¢†¢¢†¢¢†¢¢†¢¢†¢¢†¢†¢¢†¢¢†¢¢†¢¢¢¢¢¢¢†¢¢†¢¢¢¢¢†¢¢†¢¢¢¢¢¢¢†¢¢†¢¢†¢¢¢¢¢¢¢†¢¢†¢¢¢¢¢†¢¢†¢†¢¢¢¢¢†¢¢¢¢¢†¢¢¢¢†¢¢†¢¢†¢¢¢¢¢†¢¢†¢†¢¢†¢¢†¢¢†¢¢†¢¢†¢†¢¢†¢¢†¢¢†¢¢†¢¢¢¢†¢¢†¢¢†¢¢†¢¢†¢¢¢¢†¢¢†¢¢†¢¢†¢¢†¢¢¢¢†¢¢†¢¢†¢¢†¢¢†¢†¢¢†¢¢†¢¢†¢¢†¢¢†¢†¢¢†¢¢¢¢¢†¢¢¢¢¢†¢¢¢¢†¢¢¢¢¢¢¢¢¢¢¢¢¢¢¢¢¢¢¢¢¢¢¢¢¢¢¢¢¢¢¢¢¢¢¢¢¢¢¢¢¢¢¢¢¢¢¢¢¢¢¢¢¢¢¢¢¢¢¢¢¢¢¢¢¢¢¢¢¢¢¢¢¢†¢¢¢¢†¢¢†¢¢†¢¢†¢¢†¢¢¢¢†¢¢†††††††¢††¢†††¢††¢††††††¢††¢†††¢††¢††††††¢††¢†††¢††¢¢††¢†¢¢††††¢†¢††¢¢††¢†¢¢††††††¢††¢†††¢†¢¢††††¢†¢††¢¢††¢†¢¢†††¢¢†¢††¢¢††¢†¢¢†††¢¢†¢††¢¢†¢¢†¢¢†¢†¢¢†¢¢†¢¢†¢¢†¢††¢†¢¢†¢¢†¢¢†¢¢¢¢††¢¢¢¢†¢¢¢¢¢†¢¢¢¢¢¢¢¢¢¢¢¢¢¢¢¢¢¢¢¢¢¢¢¢¢¢¢¢¢¢¢¢¢¢¢¢¢¢¢¢¢¢¢¢¢¢¢¢¢¢¢¢¢¢¢¢¢¢¢¢¢¢¢¢¢¢¢¢¢¢¢¢¢¢¢¢¢¢¢¢¢¢¢¢¢¢¢¢¢¢¢¢¢¢¢¢¢¢¢¢¢†¢¢¢¢†¢¢¢¢¢†¢¢¢¢¢†¢¢¢¢†¢¢¢¢¢†¢¢†¢¢†¢†¢¢†¢¢†¢¢†¢¢¢¢¢†¢¢¢¢†¢¢¢¢¢†¢¢¢¢††¢¢¢¢†¢¢¢¢¢†¢¢¢¢††¢¢¢¢†¢¢¢¢¢†¢¢¢¢††¢¢¢¢†¢¢¢¢¢¢¢¢¢¢¢¢¢¢¢¢¢¢¢¢¢¢¢¢¢¢¢¢¢¢¢¢¢¢¢¢¢¢¢¢¢¢¢¢¢¢¢¢¢¢¢¢¢¢¢¢¢¢¢¢¢¢¢¢¢¢¢¢¢¢¢¢¢¢¢¢¢¢¢¢¢¢¢¢¢¢¢¢¢¢¢¢¢¢¢†¢¢¢¢¢†¢¢¢¢††¢††¢†¢¢†¢††¢††¢††¢††¢†¢¢¢¢††¢¢¢¢††¢¢†¢†¢¢¢¢†¢¢¢¢¢¢†¢¢¢¢¢¢†¢¢†¢¢¢¢¢¢†¢¢¢¢¢¢†¢¢†¢¢¢¢¢††¢¢¢¢¢¢†¢¢†¢¢¢†¢¢†¢¢¢¢¢¢†¢¢¢¢¢¢†¢¢†¢¢¢¢¢¢†¢¢¢¢¢¢†¢¢†¢¢¢¢¢¢†¢¢¢¢¢¢¢¢¢¢¢¢¢†¢¢†¢¢¢¢¢¢¢¢¢¢¢¢¢†¢¢†¢¢¢¢¢¢¢¢¢¢¢¢¢†¢¢†¢¢¢¢¢¢¢¢¢¢¢¢¢†¢¢¢¢¢¢¢¢¢¢¢¢¢¢¢¢†¢¢¢¢¢¢¢¢¢¢¢¢¢†¢¢†¢¢¢¢¢¢¢¢¢¢¢¢¢†¢¢†¢¢¢¢¢¢¢¢¢¢¢¢¢†¢¢†¢¢¢¢¢¢¢¢¢¢¢¢¢†¢¢†¢¢¢¢¢¢¢¢¢¢¢¢¢†¢¢¢¢¢¢¢¢¢¢¢¢¢¢¢¢†¢¢¢¢¢¢¢¢¢¢¢¢¢¢¢¢†¢¢¢¢¢¢¢¢¢¢¢¢¢†¢¢†¢¢¢¢¢¢¢¢¢¢¢¢¢†¢¢†¢¢¢¢¢¢¢¢¢¢¢¢¢†¢¢†¢¢¢¢¢¢¢¢¢¢¢¢¢†¢¢¢¢¢¢¢¢¢¢¢¢¢¢¢¢†¢¢¢¢¢¢¢¢¢¢¢¢¢¢¢¢¢¢¢¢¢¢¢¢¢¢¢¢¢¢¢¢¢¢¢¢¢¢¢¢¢¢¢¢¢¢¢¢¢¢†¢¢¢¢¢¢¢¢¢¢¢¢¢†¢¢†¢¢¢¢¢¢¢¢¢¢†¢†¢¢††¢††¢¢†¢¢††¢¢†¢¢†¢¢††¢¢†¢¢††¢¢†¢¢†¢¢††¢¢†¢¢††¢¢†¢¢††¢¢†¢¢†¢¢††¢¢†¢¢††¢¢†¢¢†¢¢††¢¢†¢¢††¢¢†¢¢†¢¢¢†¢¢†¢¢††¢¢†¢¢††¢¢†¢¢†¢¢††¢¢†¢¢††¢¢†¢¢†¢¢††¢¢†¢¢††¢¢†¢¢††¢¢†¢¢†¢¢††¢¢¢¢¢¢†¢¢†¢¢†¢¢†¢¢¢¢¢¢¢†¢¢†¢¢†¢¢¢¢¢¢¢¢¢¢†¢¢†¢¢†¢¢¢¢¢¢¢¢¢¢¢¢¢†¢¢¢¢¢¢¢¢¢¢¢¢¢¢¢¢†¢¢¢¢¢¢¢¢¢¢†¢¢¢¢¢†¢¢¢¢¢¢¢¢¢¢†¢¢¢¢¢†¢¢†¢¢¢¢¢¢¢†¢¢†¢¢†¢¢†¢¢¢¢¢¢¢†¢¢†¢¢†¢¢¢¢¢¢¢¢¢¢†¢¢†¢¢†¢¢¢¢¢¢¢¢¢¢†¢¢†¢¢†¢¢¢¢¢¢¢¢¢¢†¢¢†¢¢†¢¢¢¢¢¢¢†¢¢†¢¢†¢¢†¢¢¢¢¢¢¢†¢¢†¢¢†¢¢†¢¢¢¢¢¢¢†¢¢†¢¢†¢¢¢¢¢¢¢¢¢¢†¢¢†¢¢†¢¢¢¢¢¢¢¢¢¢¢¢¢†¢¢¢¢¢¢¢¢¢¢¢¢¢¢¢¢¢¢¢¢¢¢¢¢¢¢¢†¢¢¢¢¢†¢¢¢¢¢¢¢¢¢¢†¢¢†¢¢†¢¢¢¢¢¢¢¢¢¢¢††††††††††††††††††††††††††††††††††††††††††††††††††††††††††††††††††††††††††††††††††††††††††††††††††¢††††††††††††††††††††††††††††¢††††††††††¢¢††††¢††¢†¢¢†¢¢†¢††¢††¢††¢†¢¢†¢¢†¢††¢††¢††¢†¢¢†¢¢¢¢††¢¢¢¢¢¢¢¢¢¢¢¢¢¢¢¢¢¢¢¢¢¢¢¢¢¢¢¢¢¢¢¢¢¢¢¢¢¢¢¢¢¢¢¢¢¢¢¢¢¢¢¢¢¢¢¢¢¢¢¢¢¢¢¢¢¢¢¢¢¢¢¢¢¢¢¢¢¢¢¢¢¢¢¢¢¢¢¢¢¢¢¢¢¢¢¢¢¢¢¢¢¢¢¢¢¢¢¢¢¢¢¢¢¢¢¢¢¢¢¢¢¢¢¢¢¢¢¢¢¢¢¢¢¢††¢¢¢¢†¢¢†¢¢†¢††¢††¢†¢¢†¢¢†¢¢†¢††¢††¢†¢¢†¢¢†¢††¢††¢††¢†¢¢†¢¢†¢††¢††¢††¢†¢¢†¢¢†¢††¢††¢†¢¢†¢¢†¢¢¢¢††¢¢¢¢¢¢¢¢¢¢¢¢¢¢¢¢¢¢¢¢¢¢¢¢¢¢¢¢¢¢¢¢¢¢¢¢¢¢¢¢¢¢¢¢¢¢¢¢¢¢¢¢¢¢¢¢¢¢¢¢¢¢¢¢¢¢¢¢¢¢¢¢¢¢¢¢¢¢†¢††¢††¢††††¢††¢††¢††¢††¢††††¢††¢††¢¢†¢††¢¢†††¢†¢¢††¢¢†¢¢††¢¢†¢¢†¢¢††¢¢†¢¢††¢¢†¢¢†¢¢††¢¢†¢¢††¢¢†¢¢††¢††¢¢†¢¢††¢¢†¢¢††¢¢†¢¢†¢¢††¢¢†¢¢††¢¢†¢¢†¢¢††¢¢†¢¢††¢¢†¢¢††¢¢†¢¢†¢¢†¢¢¢¢¢¢¢†¢¢†¢¢†¢¢†¢¢¢¢¢¢¢†¢¢†¢¢†¢¢†¢¢¢¢¢¢¢†¢¢¢¢¢†¢¢¢¢¢¢¢¢¢¢¢¢¢¢¢¢†¢¢¢¢¢¢¢¢¢¢¢¢¢¢¢¢¢¢¢¢¢¢¢¢¢¢¢¢¢¢¢¢¢†¢¢¢¢¢¢¢¢¢¢†¢¢¢¢¢†¢¢¢¢¢¢¢¢¢¢†¢¢¢¢¢†¢¢¢¢¢¢¢¢¢¢†¢¢†¢¢¢¢¢¢¢¢¢¢†¢¢†¢¢†¢¢¢¢¢¢¢¢¢¢†¢¢†¢¢†¢¢¢¢¢¢¢†¢¢†¢¢†¢¢†¢¢¢¢¢¢¢†¢¢†¢¢†¢¢†¢¢¢¢¢¢¢†¢¢†¢¢†¢¢†¢¢¢¢¢¢¢†¢¢†¢¢†¢¢¢¢¢¢¢¢¢¢†¢¢†¢¢†¢¢¢¢¢¢¢¢¢¢†¢¢†¢¢†¢¢¢¢¢¢¢¢¢¢